# MongoDB Atlas or a local replica set (transactions are required).
MONGODB_URI=mongodb://127.0.0.1:27017/almakkah?replicaSet=rs0
MONGODB_DB=almakkah
# Generate with: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:3000
# Used by npm run seed; no default administrator password exists.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
